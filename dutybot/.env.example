# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string, e.g. postgresql+asyncpg://user:password@host:5432/dutybot
DATABASE_URL=

# Comma separated list of Telegram user IDs allowed to perform admin actions
ADMIN_IDS=

# Telegram group (chat) ID where duties are published, e.g. -1001234567890
GROUP_CHAT_ID=

# Telegram forum topic (message_thread_id) ID inside the group, optional
GROUP_TOPIC_ID=

# IANA timezone used for scheduling and displaying dates
TIMEZONE=Asia/Singapore

# Number of seconds before temporary bot messages are auto-deleted
AUTO_DELETE_SECONDS=300

# Optional: logging verbosity and file path
LOG_LEVEL=INFO
LOG_FILE=dutybot.log
